{
  "name": "codex-unfence",
  "version": "0.0.2",
  "license": "MIT",
  "description": "Install, check and uninstall a recoverable Codex browser site-status patch on macOS",
  "author": {
    "name": "pzehrel",
    "url": "https://github.com/pzehrel"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pzehrel/codex-unfence.git"
  },
  "homepage": "https://github.com/pzehrel/codex-unfence#readme",
  "bugs": {
    "url": "https://github.com/pzehrel/codex-unfence/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "codex-unfence": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:tools": "tsx scripts/build-tools.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "check": "tsx scripts/check.ts",
    "test": "pnpm run build && pnpm run build:tools && node --test .build/tests/*.test.js",
    "test:package": "pnpm run build && pnpm run build:tools && node --test .build/tests/package.test.js",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/eslint-scope": "3.7.7",
    "@types/estree": "1.0.8",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "jiti": "2.7.0",
    "pnpm": "10.34.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "bundleDependencies": [
    "acorn",
    "eslint-scope"
  ],
  "dependencies": {
    "acorn": "8.15.0",
    "eslint-scope": "8.4.0"
  }
}
