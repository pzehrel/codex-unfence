{
  "name": "codex-browser-liberation-patch",
  "version": "0.1.0",
  "description": "Structural review plans and recoverable transactions for Codex browser plugins on macOS",
  "type": "module",
  "bin": {
    "codex-browser-patch": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist/analysis.js",
    "dist/source-context.js",
    "dist/deferred-analysis.js",
    "dist/dependency-analysis.js",
    "dist/dependency-contracts.js",
    "dist/dependency-source.js",
    "dist/descriptor-provenance.js",
    "dist/resource-provenance.js",
    "dist/loader-configuration-proof.js",
    "dist/handle-provenance.js",
    "dist/cli.js",
    "dist/managed-cli.js",
    "dist/guide.js",
    "dist/cua-contract.js",
    "dist/cua-analysis.js",
    "dist/cua-recipe.js",
    "dist/cua-admission.js",
    "dist/installations.js",
    "dist/managed-patches.js",
    "dist/managed-state.js",
    "dist/discovery.js",
    "dist/integrity.js",
    "dist/plan.js",
    "dist/processes.js",
    "dist/result.js",
    "dist/transaction-engine.js",
    "dist/transaction-locks.js",
    "dist/transaction-storage.js",
    "dist/transactions.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "node scripts/check.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:package": "npm run build && node --test tests/package.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/eslint-scope": "3.7.7",
    "@types/estree": "1.0.8",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "bundleDependencies": [
    "acorn",
    "eslint-scope"
  ],
  "dependencies": {
    "acorn": "8.15.0",
    "eslint-scope": "8.4.0"
  }
}
